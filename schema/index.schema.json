{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thiennguyen93/amee-store/main/schema/index.schema.json",
  "title": "Amee store index",
  "description": "The published index.json at the repo root — the store's public API, read by the homepage and (later) by Amee itself. Generated by tools/build-index.mjs and committed by CI; never hand-edited. Keyed by kind so a second registry can appear without changing the shape of the first.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "kinds"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "kinds": {
      "type": "object",
      "required": ["skins", "extensions"],
      "additionalProperties": false,
      "properties": {
        "skins": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
        "extensions": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "id", "name", "version", "license", "preview",
        "download", "sha256", "sizeBytes", "sourceUrl", "publishedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "license": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "homepage": { "type": ["string", "null"] },
        "sdkVersion": { "type": ["string", "null"] },
        "minAmeeVersion": { "type": ["string", "null"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "resizable": { "type": "boolean" },
        "preview": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "download": {
          "type": "string",
          "description": "Absolute URL of the .ybskin release asset. Amee's deep-link installer allowlists the host, so this must stay on github.com."
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sourceUrl": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
